<dx:ThemedWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    x:Class="HRMS.windows.PayslipWindow"
    Title="{DynamicResource payslipWindow}" Height="800" Width="1000"
    >

    <Grid>
        <dxp:DocumentPreviewControl CommandBarStyle="Bars" Name="preview" ShowPageMargins="False" Margin="0,0,0,0" ShowNavigationPane="False" />
    </Grid>
    <Window.Resources>
        <DataTemplate x:Key="HeaderTemplate">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="dxe:TextEdit">
                        <Setter Property="Padding" Value="3,0,3,0" />
                        <Setter Property="FontSize" Value="25" />
                    </Style>
                </StackPanel.Resources>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="400"/>
                        <ColumnDefinition MinWidth="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="70"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <dxe:TextEdit BorderBrush="LightGray" BorderThickness="1,0,0,1" 
                              Text="{Binding Content, Mode=OneWay}" FontWeight="Bold" FontSize="40" Grid.Row="0" Grid.ColumnSpan="2" HorizontalContentAlignment="Center"/>
                    <dxe:TextEdit Foreground="White" Background="SteelBlue" BorderBrush="White" 
                              BorderThickness="1,1,0,1" Grid.Column="0" Grid.Row="1"/>
                    <dxe:TextEdit Foreground="White" Background="SteelBlue" BorderBrush="White" 
                              BorderThickness="1,1,0,1" Grid.Column="1" Grid.Row="1"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Payslip">
            <StackPanel Orientation="Vertical">
                <StackPanel.Resources>
                    <Style TargetType="dxe:TextEdit">
                        <Setter Property="Padding" Value="0,0,0,0" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                </StackPanel.Resources>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="400"/>
                        <ColumnDefinition MinWidth="200"/>
                    </Grid.ColumnDefinitions>
                    <dxe:TextEdit BorderBrush="LightGray" BorderThickness="1,0,0,1" 
                              Grid.Column="0" Text="{Binding Path=Content.Name}" FontWeight="Bold"/>
                    <dxe:TextEdit BorderBrush="LightGray" BorderThickness="1,0,0,1" 
                              Grid.Column="1" Text="{Binding Path=Content.Value}" HorizontalContentAlignment="Right"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
</dx:ThemedWindow>
