<dx:ThemedWindow
    x:Class="HRMS.windows.TimekeepingWindow"
    x:Name="window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Width="500"
    Height="400"
    Closed="window_Closed"
    Title="{DynamicResource timekeepingWindow}">

    <Grid x:Name="grid" Margin="20, 0, 0, 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Border
                Grid.Row="1"
                Margin="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="Black"
                BorderThickness="0">
            <Image
                    x:Name="MyImage"
                    Width="200"
                    Height="200"
                    Margin="1"
                    Source="{dx:DXImage SvgImages/Business Objects/BO_Lead.svg}"
                    Stretch="Fill" />
        </Border>
        <TextBlock
                Grid.Row="0"
                Margin="0,15,0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Times New Roman"
                FontSize="22.667"
                Foreground="#FF1059A3"
                Text="{DynamicResource scanQRMessage}"
                TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{DynamicResource id}" />
            <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{DynamicResource name}" />
            <TextBlock x:Name="arrriveTimeLabel"
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="{DynamicResource arriveTime}" />
            <TextBlock x:Name="leaveTimeLabel"
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="{DynamicResource leaveTime}" />
            <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text=":" />
            <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text=":" />
            <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text=":" />
            <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text=":" />
            <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0"
                    Foreground="#FF1059A3"
                    Text="{Binding Path=id}"
                    TextWrapping="Wrap" />
            <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0"
                    Foreground="#FF1059A3"
                    Text="{Binding Path=name}"
                    TextWrapping="Wrap" />
            <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,0"
                    Foreground="#FF1059A3"
                    x:Name="arriveTime"
                    TextWrapping="Wrap" />
            <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="10,0"
                    Foreground="#FF1059A3"
                    x:Name="leaveTime"
                    TextWrapping="Wrap" />

        </Grid>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" x:Name="close" Content="{DynamicResource cancel}" Click="cancel_Click" Height="30" Width="100"/>
            <TextBlock DockPanel.Dock="Right" x:Name="resultMessage" VerticalAlignment="Center" Foreground="#FF1059A3" />
        </DockPanel>
    </Grid>
</dx:ThemedWindow>
