<dx:ThemedWindow
    x:Class="HRMS.windows.TokenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="{DynamicResource tokenWindow}" Width="520" Height="570"
    >
    <StackPanel>
        <dxe:BarCodeEdit x:Name="qr" HorizontalTextAlignment="Center" HorizontalAlignment="Center" Width="460" HorizontalContentAlignment="Center" Height="400">
            <dxe:BarCodeEdit.StyleSettings>
                <dxe:QRCodeStyleSettings CompactionMode="Byte" />
            </dxe:BarCodeEdit.StyleSettings>
        </dxe:BarCodeEdit>
        <TextBlock Margin="16,4,16,2" Text="{DynamicResource connectionInfo}" />
        <TextBox x:Name="connectionInfoTextBox" Margin="16,0,16,8" IsReadOnly="True"
                 HorizontalScrollBarVisibility="Auto" />
        <Button x:Name="confirm" Margin="16,0,16,12" Height="34" Content="{DynamicResource confirm}" Click="confirm_Click"/>
    </StackPanel>

</dx:ThemedWindow>
