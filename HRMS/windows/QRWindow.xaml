<dx:ThemedWindow
    x:Class="HRMS.windows.QRWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="{DynamicResource qrWindow}" Width="500" Height="510"
    >
    <StackPanel>
        <dxe:BarCodeEdit x:Name="qr" HorizontalTextAlignment="Center" HorizontalAlignment="Center" Width="500" HorizontalContentAlignment="Center" Height="440" >
            <dxe:BarCodeEdit.StyleSettings>
                <dxe:QRCodeStyleSettings CompactionMode="Byte" />
            </dxe:BarCodeEdit.StyleSettings>
        </dxe:BarCodeEdit>
    </StackPanel>

</dx:ThemedWindow>
