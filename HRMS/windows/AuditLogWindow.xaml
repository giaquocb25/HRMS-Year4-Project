<dx:ThemedWindow
    x:Class="HRMS.windows.AuditLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="{DynamicResource systemAudit}" Width="850" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Button Content="{DynamicResource refresh}" Width="100" Height="30" HorizontalAlignment="Left" Click="refresh_Click" />
        <DataGrid Grid.Row="1" x:Name="auditGrid" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedTime, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="145" />
                <DataGridTextColumn Header="{DynamicResource user}" Binding="{Binding Username}" Width="110" />
                <DataGridTextColumn Header="{DynamicResource action}" Binding="{Binding Action}" Width="120" />
                <DataGridTextColumn Header="{DynamicResource entity}" Binding="{Binding EntityType}" Width="100" />
                <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="80" />
                <DataGridTextColumn Header="{DynamicResource details}" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</dx:ThemedWindow>
