<dx:ThemedWindow
    x:Class="HRMS.windows.ImageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="{DynamicResource imageWindow}" Height="500" Width="600"
    >

    <StackPanel>

        <TextBox x:Name="ImagePath" IsReadOnly="True" Margin="12,12,12,6" />
        <Image x:Name="MyImage" Width="560" Height="360" Stretch="Uniform" Margin="12,0,12,12">
            <Image.Source>
                <BitmapImage UriSource="{Binding ElementName=ImagePath, Path=Text}"/>
            </Image.Source>
        </Image>
        <Button x:Name="BrowseButton" Content="Chọn ảnh" Click="BrowseButton_OnClick" Margin="12,0,12,6" Height="32"/>
        <Button x:Name="SaveButton" Content="{DynamicResource save}" Click="SaveButton_OnClick" Margin="12,0,12,12" Height="32"/>

    </StackPanel>
</dx:ThemedWindow>
